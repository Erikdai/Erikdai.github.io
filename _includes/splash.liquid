{% comment %}
  Homepage intro splash. Rendered by the local `_layouts/about.liquid` when the page's
  front matter has `splash.enabled: true`; styles + the first-paint guard that adds
  `html.splash-pending` live in `_includes/head.liquid`.

  Behaviour: a particle network draws on a canvas, "hello" in many languages
  (`page.splash.greetings`) floats slowly all over the screen, and the name fades in letter
  by letter; a small down arrow bounces at the bottom. It never dismisses itself: the
  visitor clicks the arrow, scrolls down, swipes up, or presses Enter / Space / Escape /
  ArrowDown, and the splash lifts away like a curtain. It plays once per tab (sessionStorage); add
  `?splash` to the URL to force it, e.g. while testing. Skipped entirely for
  `prefers-reduced-motion` and when JS is off.
{% endcomment %}
{% if site.title == 'blank' %}
  {% capture splash_name %}{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}{% endcapture %}
{% else %}
  {% capture splash_name %}{{ site.title }}{% endcapture %}
{% endif %}
{% assign splash_name = splash_name | strip | replace: '   ', ' ' | replace: '  ', ' ' %}
{% assign splash_words = splash_name | split: ' ' %}
{% assign splash_i = 0 %}
<div id="splash" aria-hidden="true">
  <canvas></canvas>
  {% if page.splash.greetings.size > 0 %}
    {%- comment -%} Floating greetings; the script below scatters them around the name. {%- endcomment -%}
    <div class="splash-float">
      {%- for g in page.splash.greetings -%}
        <span class="fw">{{ g }}</span>
      {%- endfor -%}
    </div>
  {% endif %}
  <div class="splash-inner">
    {%- comment -%} One .word per word so line breaks only fall between words; --i staggers the letters. {%- endcomment -%}
    <p class="splash-name" lang="en">
      {%- for word in splash_words -%}
        {%- assign word_chars = word | split: '' -%}
        <span class="word">
          {%- for ch in word_chars -%}
            <span class="ch" style="--i: {{ splash_i }}">{{ ch }}</span>
            {%- assign splash_i = splash_i | plus: 1 -%}
          {%- endfor -%}
        </span>
      {%- endfor -%}
    </p>
    <div class="splash-rule"></div>
    {% if page.splash.subtitle %}
      <p class="splash-sub">{% include lang.liquid en=page.splash.subtitle zh=page.splash.subtitle_zh %}</p>
    {% endif %}
  </div>
  <button type="button" class="splash-down" id="splash-down" aria-label="{{ page.splash.enter_label | default: 'Enter' }}" title="{{ page.splash.enter_label | default: 'Enter' }}">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
  </button>
</div>
<script>
  (function () {
    var root = document.documentElement;
    var el = document.getElementById("splash");
    if (!el) return;

    // head.liquid only adds this class when the splash should play this time.
    if (!root.classList.contains("splash-pending")) {
      el.parentNode.removeChild(el);
      return;
    }

    var finished = false;
    var raf = 0;

    // Whatever happens below, the page must never stay hidden.
    function bail() {
      root.classList.remove("splash-pending");
      root.classList.remove("splash-leaving");
      if (el.parentNode) el.parentNode.removeChild(el);
    }

    try {
      try {
        sessionStorage.setItem("jd-splash-seen", "1");
      } catch (e) {}

      /* ---------- particle network ---------- */
      var canvas = el.querySelector("canvas");
      var ctx = canvas.getContext("2d");
      var accent = (getComputedStyle(root).getPropertyValue("--global-theme-color") || "").trim();
      var m = /^#?([0-9a-f]{6})$/i.exec(accent);
      var rgb = m
        ? [parseInt(m[1].slice(0, 2), 16), parseInt(m[1].slice(2, 4), 16), parseInt(m[1].slice(4, 6), 16)]
        : [38, 152, 186];
      var dark = root.getAttribute("data-theme") === "dark";
      var lineAlpha = dark ? 0.4 : 0.3;
      var dotAlpha = dark ? 0.75 : 0.6;
      var LINK = 140;
      var W = 0, H = 0, dpr = 1;
      var nodes = [];
      var mouse = { x: -1e9, y: -1e9 };

      function size() {
        // under the desktop CSS zoom (head.liquid) one CSS px covers pageZoom() screen px: render sharper to match
        dpr = Math.min((window.devicePixelRatio || 1) * (window.pageZoom ? window.pageZoom() : 1), 3);
        W = el.clientWidth;
        H = el.clientHeight;
        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      function seed() {
        var n = Math.max(45, Math.min(110, Math.round((W * H) / 15000)));
        nodes = [];
        for (var i = 0; i < n; i++) {
          nodes.push({
            x: Math.random() * W,
            y: Math.random() * H,
            vx: (Math.random() - 0.5) * 0.4,
            vy: (Math.random() - 0.5) * 0.4,
            r: 1 + Math.random() * 1.6,
          });
        }
      }

      function rgba(a) {
        return "rgba(" + rgb[0] + "," + rgb[1] + "," + rgb[2] + "," + a + ")";
      }

      function step() {
        ctx.clearRect(0, 0, W, H);
        var i, j, a, b, dx, dy, d2, d;
        for (i = 0; i < nodes.length; i++) {
          a = nodes[i];
          // gentle pull towards the pointer
          dx = mouse.x - a.x;
          dy = mouse.y - a.y;
          d2 = dx * dx + dy * dy;
          if (d2 < 180 * 180 && d2 > 1) {
            d = Math.sqrt(d2);
            a.vx += (dx / d) * 0.012;
            a.vy += (dy / d) * 0.012;
          }
          // keep speeds bounded
          var sp = Math.sqrt(a.vx * a.vx + a.vy * a.vy);
          if (sp > 0.9) {
            a.vx *= 0.9 / sp;
            a.vy *= 0.9 / sp;
          }
          a.x += a.vx;
          a.y += a.vy;
          if (a.x < -10) a.x = W + 10;
          else if (a.x > W + 10) a.x = -10;
          if (a.y < -10) a.y = H + 10;
          else if (a.y > H + 10) a.y = -10;
        }
        ctx.lineWidth = 0.8;
        for (i = 0; i < nodes.length; i++) {
          a = nodes[i];
          for (j = i + 1; j < nodes.length; j++) {
            b = nodes[j];
            dx = a.x - b.x;
            dy = a.y - b.y;
            d2 = dx * dx + dy * dy;
            if (d2 < LINK * LINK) {
              d = Math.sqrt(d2);
              ctx.strokeStyle = rgba((1 - d / LINK) * lineAlpha);
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(b.x, b.y);
              ctx.stroke();
            }
          }
        }
        ctx.fillStyle = rgba(dotAlpha);
        for (i = 0; i < nodes.length; i++) {
          a = nodes[i];
          ctx.beginPath();
          ctx.arc(a.x, a.y, a.r, 0, Math.PI * 2);
          ctx.fill();
        }
        raf = requestAnimationFrame(step);
      }

      /* ---------- floating greetings: scattered on a grid that leaves the middle for the name ---------- */
      var words = el.querySelectorAll(".splash-float .fw");
      var placed = false;
      function placeWords() {
        if (!words.length) return;
        var portrait = W < 700;
        var cols = portrait ? 4 : 6;
        var rows = portrait ? 7 : 4;
        var zx = portrait ? 0.1 : 0.24; // keep-out box around the name / button
        var zy = portrait ? 0.34 : 0.28;
        var cells = [];
        for (var r = 0; r < rows; r++) {
          for (var c = 0; c < cols; c++) {
            var cx = (c + 0.5) / cols;
            var cy = (r + 0.5) / rows;
            if (cx > zx && cx < 1 - zx && cy > zy && cy < 1 - zy) continue;
            if (cy > 0.8 && cx > 0.3 && cx < 0.7) continue; // leave the bottom centre for the down arrow
            cells.push([cx, cy]);
          }
        }
        for (var k = cells.length - 1; k > 0; k--) {
          var s = Math.floor(Math.random() * (k + 1));
          var t = cells[k];
          cells[k] = cells[s];
          cells[s] = t;
        }
        for (var i = 0; i < words.length; i++) {
          var cell = cells[i % cells.length];
          var jx = (Math.random() - 0.5) * 0.5 / cols;
          var jy = (Math.random() - 0.5) * 0.5 / rows;
          var w = words[i];
          w.style.left = ((cell[0] + jx) * 100).toFixed(2) + "%";
          w.style.top = ((cell[1] + jy) * 100).toFixed(2) + "%";
          if (!placed) {
            w.style.setProperty("--fs", (0.95 + Math.random() * 1.45).toFixed(2));
            w.style.setProperty("--op", (0.22 + Math.random() * 0.3).toFixed(2));
            w.style.setProperty("--dx", ((Math.random() - 0.5) * 70).toFixed(0) + "px");
            w.style.setProperty("--dy", ((Math.random() - 0.5) * 70).toFixed(0) + "px");
            w.style.setProperty("--dur", (18 + Math.random() * 16).toFixed(1) + "s");
            w.style.setProperty("--in-delay", (0.3 + Math.random() * 1.6).toFixed(2) + "s");
            if (i % 3 === 0) w.style.color = accent || "#2698ba";
          }
        }
        placed = true;
      }

      function onMove(e) {
        var z = window.pageZoom ? window.pageZoom() : 1; // clientX/Y are zoomed px, the nodes live in CSS px
        mouse.x = e.clientX / z;
        mouse.y = e.clientY / z;
      }
      function onLeave() {
        mouse.x = mouse.y = -1e9;
      }
      function onResize() {
        size();
        for (var i = 0; i < nodes.length; i++) {
          if (nodes[i].x > W) nodes[i].x = Math.random() * W;
          if (nodes[i].y > H) nodes[i].y = Math.random() * H;
        }
        placeWords();
      }

      size();
      seed();
      step();
      placeWords();

      /* ---------- text timeline: wait (briefly) for the web font so letters do not swap mid-reveal ---------- */
      var readyFired = false;
      function ready() {
        if (readyFired) return;
        readyFired = true;
        el.classList.add("is-ready");
      }
      if (document.fonts && document.fonts.ready && document.fonts.ready.then) {
        document.fonts.ready.then(ready, ready);
      }
      setTimeout(ready, 600);

      /* ---------- dismissal: arrow click, wheel down, swipe up, or a key ---------- */
      var downBtn = document.getElementById("splash-down");
      var touchY = null;
      function dismiss() {
        if (finished) return;
        finished = true;
        if (downBtn) downBtn.removeEventListener("click", dismiss);
        window.removeEventListener("keydown", onKey);
        el.removeEventListener("wheel", onWheel);
        el.removeEventListener("touchstart", onTouchStart);
        el.removeEventListener("touchmove", onTouchMove);
        root.classList.remove("splash-pending");
        root.classList.add("splash-leaving");
        el.classList.add("is-out");
        setTimeout(function () {
          cancelAnimationFrame(raf);
          el.removeEventListener("pointermove", onMove);
          el.removeEventListener("pointerleave", onLeave);
          window.removeEventListener("resize", onResize);
          root.classList.remove("splash-leaving");
          if (el.parentNode) el.parentNode.removeChild(el);
        }, 1000);
      }
      function onKey(e) {
        if (e.key === "Enter" || e.key === " " || e.key === "Escape" || e.key === "ArrowDown" || e.key === "PageDown") {
          e.preventDefault();
          dismiss();
        }
      }
      function onWheel(e) {
        if (e.deltaY > 0) {
          e.preventDefault();
          dismiss();
        }
      }
      function onTouchStart(e) {
        touchY = e.touches.length ? e.touches[0].clientY : null;
      }
      function onTouchMove(e) {
        if (touchY === null || !e.touches.length) return;
        if (touchY - e.touches[0].clientY > 30) dismiss(); // finger moved up: "scroll down"
      }

      el.addEventListener("pointermove", onMove, { passive: true });
      el.addEventListener("pointerleave", onLeave);
      window.addEventListener("resize", onResize);
      if (downBtn) downBtn.addEventListener("click", dismiss);
      window.addEventListener("keydown", onKey);
      el.addEventListener("wheel", onWheel, { passive: false });
      el.addEventListener("touchstart", onTouchStart, { passive: true });
      el.addEventListener("touchmove", onTouchMove, { passive: true });

      // Tells the backstop in head.liquid that the splash is alive and will dismiss itself on click.
      window.__splashOk = true;
    } catch (err) {
      bail();
      if (window.console) console.warn("splash disabled:", err);
    }
  })();
</script>
