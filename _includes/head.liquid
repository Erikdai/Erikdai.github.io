<!-- Security: Content Security Policy -->
<!-- Permissive CSP suitable for academic websites. Allows external images, videos, and common embed services. -->
<!-- To customize for your needs, see: https://developer.mozilla.org/en-US/docs/Web/HTTP/CSP -->
<meta
  http-equiv="Content-Security-Policy"
  content="default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; media-src 'self' https:; frame-src 'self' https:; connect-src 'self' https:;"
>
<style>
  :root {
    --max-content-width: {{ site.max_width | default: '930px' }};
  }
</style>
<!-- Desktop opens at 125% (user request 2026-10-20: "打开就是 zoom in 125%，只要电脑端，手机端不要"): CSS zoom on the root,
     only for wide screens driven by a mouse; phones and tablets stay at 100%. Under zoom, getBoundingClientRect() and
     mouse clientX/Y are in zoomed pixels while CSS lengths are not, so scripts that write measured pixels back into
     styles divide by window.pageZoom(). -->
<style>
  @media (min-width: 1280px) and (hover: hover) and (pointer: fine) {
    html { zoom: 1.25; }
  }
</style>
<script>
  window.pageZoom = function () {
    var b = document.body;
    if (!b || !b.offsetWidth) return 1;
    var z = b.getBoundingClientRect().width / b.offsetWidth;
    return z > 0.5 && z < 4 ? z : 1;
  };
</script>

