<!-- Custom override: use a blue accent in light mode too (dark mode keeps its own, higher-specificity color) -->
<style>
  :root {
    --global-theme-color: #2698ba;
    --global-hover-color: #2698ba;
    --global-code-bg-color: rgba(38, 152, 186, 0.05);
  }
  /* ===== Projects: equal-height cards, icon row pinned to the bottom, cursor-following tilt + spotlight ===== */
  .projects .col { perspective: 1000px; }
  .projects .card {
    --rx: 0deg; --ry: 0deg; --mx: 50%; --my: 50%;
    position: relative;
    overflow: hidden;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform .5s cubic-bezier(.2, .7, .2, 1), box-shadow .5s ease;
  }
  .projects .card.is-tilting { transition: transform .1s linear, box-shadow .5s ease; }
  .projects .card:hover {
    transform: rotateX(var(--rx)) rotateY(var(--ry)) translateY(-8px);
    box-shadow: 0 22px 40px rgba(0, 0, 0, .16), 0 6px 14px rgba(0, 0, 0, .08);
  }
  /* The title link is "stretched" over the whole card (no nested anchors, see projects.liquid) */
  .projects .card-title .project-link { color: inherit; text-decoration: none; }
  .projects .card-title .project-link::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .projects .card-body .project-links { position: relative; z-index: 4; }
  /* spotlight that follows the cursor */
  .projects .card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(360px circle at var(--mx) var(--my), rgba(38, 152, 186, .16), transparent 60%);
    transition: opacity .35s ease;
  }
  /* glowing accent border that brightens near the cursor */
  .projects .card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    padding: 1.5px;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(320px circle at var(--mx) var(--my), var(--global-theme-color), rgba(38, 152, 186, .15) 70%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    transition: opacity .35s ease;
  }
  @supports (color: color-mix(in srgb, red, red)) {
    .projects .card::after { background: radial-gradient(360px circle at var(--mx) var(--my), color-mix(in srgb, var(--global-theme-color) 16%, transparent), transparent 60%); }
    .projects .card::before { background: radial-gradient(320px circle at var(--mx) var(--my), var(--global-theme-color), color-mix(in srgb, var(--global-theme-color) 15%, transparent) 70%); }
  }
  .projects .card:hover::after, .projects .card:hover::before { opacity: 1; }
  .projects .card figure { margin: 0; overflow: hidden; }
  .projects .card-img-top { aspect-ratio: 2 / 1; object-fit: cover; width: 100%; transition: transform .7s cubic-bezier(.2, .7, .2, 1); }
  .projects .card:hover .card-img-top { transform: scale(1.06); }
  .projects .card-title { transition: color .25s ease; }
  .projects .card:hover .card-title { color: var(--global-theme-color); }
  .projects .card-body { display: flex; flex-direction: column; }
  .projects .card-body .card-text { flex: 1 1 auto; }
  .projects .card-body > .row { margin-top: auto; padding-top: .9rem; }
  .projects .card-body .github-icon { margin-right: 1.1rem; }
  .projects .card-body .github-icon:last-child { margin-right: 0; }
  .projects .card-body .gh-icon { display: inline-block; transition: transform .2s ease, color .2s ease; }
  .projects .card-body .icon a:hover .gh-icon { transform: translateY(-2px) scale(1.2); color: var(--global-theme-color); }

  /* ===== Publications: per-entry hover highlight (tint + accent bar + cursor glow), lively thumbnails and buttons ===== */
  .publications ol.bibliography > li > .row {
    --mx: 50%; --my: 50%;
    position: relative;
    border-radius: .6rem;
    padding: .6rem 0;
    transition: background-color .3s ease, transform .3s cubic-bezier(.2, .7, .2, 1), box-shadow .3s ease;
  }
  .publications ol.bibliography > li > .row::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1rem;
    bottom: 1rem;
    width: 3px;
    border-radius: 3px;
    background: var(--global-theme-color);
    transform: scaleY(0);
    transition: transform .3s ease;
  }
  .publications ol.bibliography > li > .row::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(420px circle at var(--mx) var(--my), rgba(38, 152, 186, .12), transparent 60%);
    transition: opacity .35s ease;
  }
  .publications ol.bibliography > li > .row:hover {
    background: rgba(38, 152, 186, .05);
    transform: translateX(6px);
    box-shadow: 0 10px 26px rgba(0, 0, 0, .07);
  }
  @supports (color: color-mix(in srgb, red, red)) {
    .publications ol.bibliography > li > .row:hover { background: color-mix(in srgb, var(--global-theme-color) 5%, transparent); }
    .publications ol.bibliography > li > .row::after { background: radial-gradient(420px circle at var(--mx) var(--my), color-mix(in srgb, var(--global-theme-color) 12%, transparent), transparent 60%); }
  }
  .publications ol.bibliography > li > .row:hover::before { transform: scaleY(1); }
  .publications ol.bibliography > li > .row:hover::after { opacity: 1; }
  .publications ol.bibliography > li > .row > * { position: relative; z-index: 1; }
  /* The text column takes the rest of the row: upstream col-sm-8 left 2/12 empty, and col-sm-10 is not in the
     purged Tailwind build (only classes the gem uses survive), so widen col-sm-8 here instead */
  @media (min-width: 576px) {
    .publications ol.bibliography > li > .row > .col-sm-8 { flex: 0 0 83.3333%; max-width: 83.3333%; }
  }
  /* Year group headings on the right: bold, one step darker so the weight shows */
  .publications h2.bibliography { font-weight: 700; color: var(--global-text-color-light); }
  .publications .preview { transition: transform .4s cubic-bezier(.2, .7, .2, 1), box-shadow .4s ease; }
  .publications ol.bibliography > li > .row:hover .preview { transform: translateY(-3px) scale(1.04); box-shadow: 0 10px 22px rgba(0, 0, 0, .18); }
  .publications .title a { transition: color .2s ease; }
  .publications .links .btn {
    border-color: var(--global-divider-color, #ddd);
    transition: background-color .2s ease, color .2s ease, border-color .2s ease, transform .2s ease, box-shadow .2s ease;
  }
  .publications .links .btn:hover {
    background: var(--global-theme-color);
    border-color: var(--global-theme-color);
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(38, 152, 186, .35);
  }

  /* ===== Gentle staggered entrance for project cards and publication entries ===== */
  @keyframes rise-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  .projects .col, .publications ol.bibliography > li { animation: rise-in .55s cubic-bezier(.2, .7, .2, 1) both; }
  .projects .col:nth-child(2), .publications ol.bibliography > li:nth-child(2) { animation-delay: .07s; }
  .projects .col:nth-child(3), .publications ol.bibliography > li:nth-child(3) { animation-delay: .14s; }
  .projects .col:nth-child(4), .publications ol.bibliography > li:nth-child(4) { animation-delay: .21s; }
  .projects .col:nth-child(5), .publications ol.bibliography > li:nth-child(5) { animation-delay: .28s; }
  .projects .col:nth-child(n + 6), .publications ol.bibliography > li:nth-child(n + 6) { animation-delay: .35s; }
  @media (prefers-reduced-motion: reduce) {
    .projects .col, .publications ol.bibliography > li { animation: none; }
    .projects .card, .projects .card-img-top, .projects .gh-icon, .publications ol.bibliography > li > .row,
    .publications .preview, .publications .links .btn { transition: none; }
    .projects .card, .projects .card:hover, .projects .card:hover .card-img-top, .publications ol.bibliography > li > .row:hover { transform: none; }
  }
  /* Slightly smaller profile avatar on tablet/desktop */
  @media (min-width: 576px) { .profile { width: 27%; } }
  /* Pronouns after the hero name only (scoped to the bold-name heading) */
  .post-title:has(> span.font-weight-bold)::after {
    content: " (he/him)";
    font-size: 0.5em;
    font-weight: 400;
    color: var(--global-text-color-light);
    white-space: nowrap;
  }
  /* Author marks (dagger = co-first, asterisk = first author) and the legend above the list */
  .publications ol.bibliography li .author { font-size: 0.86rem; }
  .publications .author-mark { margin-left: 0.05em; color: var(--global-theme-color); font-weight: 600; }
  .pub-legend { margin: -0.5rem 0 1.25rem; font-size: 0.9rem; color: var(--global-text-color-light); }
  .pub-legend .mark { color: var(--global-theme-color); font-weight: 600; }
  /* Paper titles are links (see _layouts/bib.liquid): keep the text colour, show the accent on hover */
  .publications .title a { color: inherit; text-decoration: none; }
  .publications .title a:hover { color: var(--global-theme-color); text-decoration: underline; text-underline-offset: 0.15em; }
  /* Underline beneath the hero slogan/subtitle */
  .desc { display: inline-block; border-bottom: 1px solid var(--global-divider-color, #e8e8e8); padding-bottom: 0.4rem; }
  /* English rendering of the slogan, in a script face (font loaded via third_party_libraries.google_fonts) */
  .desc .subtitle-en {
    display: inline-block;
    margin-top: 0.2rem;
    font-family: "Great Vibes", cursive;
    font-size: 1.3em;
    line-height: 1.3;
    color: var(--global-text-color-light);
  }
</style>
<script>
  // Cursor-following tilt (project cards) and spotlight (project cards + publication entries).
  // Hover-capable, fine-pointer devices only; disabled when the user prefers reduced motion.
  (function () {
    function init() {
      if (!window.matchMedia || !window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      function bind(el, tilt) {
        var rect = null, raf = null, last = null, zoom = 1;
        function apply() {
          raf = null;
          if (!rect || !last) return;
          var x = last.clientX - rect.left, y = last.clientY - rect.top; // zoomed px
          el.style.setProperty("--mx", (x / zoom).toFixed(1) + "px");
          el.style.setProperty("--my", (y / zoom).toFixed(1) + "px");
          if (tilt) {
            el.style.setProperty("--rx", ((0.5 - y / rect.height) * 7).toFixed(2) + "deg");
            el.style.setProperty("--ry", ((x / rect.width - 0.5) * 9).toFixed(2) + "deg");
          }
        }
        el.addEventListener("mouseenter", function (e) {
          rect = el.getBoundingClientRect();
          zoom = window.pageZoom ? window.pageZoom() : 1;
          last = e;
          if (tilt) el.classList.add("is-tilting");
          apply();
        });
        el.addEventListener("mousemove", function (e) {
          last = e;
          if (!raf) raf = requestAnimationFrame(apply);
        });
        el.addEventListener("mouseleave", function () {
          rect = null;
          last = null;
          if (tilt) {
            el.classList.remove("is-tilting");
            el.style.setProperty("--rx", "0deg");
            el.style.setProperty("--ry", "0deg");
          }
        });
      }
      document.querySelectorAll(".projects .card").forEach(function (el) { bind(el, true); });
      document.querySelectorAll(".publications ol.bibliography > li > .row").forEach(function (el) { bind(el, false); });
    }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
    else init();
  })();
</script>

{% if page.splash.enabled %}
  <!-- Intro splash (homepage). Decided before first paint so nothing flickers; markup + behaviour live in
       _includes/splash.liquid, rendered by the local _layouts/about.liquid. -->
  <script>
    (function () {
      var root = document.documentElement;
      try {
        var force = /[?&#]splash\b/.test(location.search + location.hash);
        if (!force) {
          if (sessionStorage.getItem("jd-splash-seen") === "1") return;
          if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        }
      } catch (e) {}
      root.classList.add("splash-pending");
      // Backstop: never leave the page hidden if the splash script fails to run
      // (it sets window.__splashOk once it is up; from then on only its button dismisses it).
      setTimeout(function () {
        if (!window.__splashOk) root.classList.remove("splash-pending");
      }, 6000);
    })();
  </script>
  <style>
    html.splash-pending { overflow: hidden; }
    html.splash-pending body > * { visibility: hidden; }
    #splash {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 2147483000;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: var(--global-bg-color, #fff);
      color: var(--global-text-color, #000);
      overflow: hidden;
      user-select: none;
      -webkit-user-select: none;
      -webkit-tap-highlight-color: transparent;
      touch-action: none;
      transition: transform 0.95s cubic-bezier(0.76, 0, 0.24, 1);
    }
    html.splash-pending #splash, html.splash-leaving #splash { display: flex; visibility: visible; }
    #splash.is-out { transform: translateY(-100%); pointer-events: none; }
    html.splash-leaving { overflow: hidden; } /* keep the page at the top while the curtain lifts */
    #splash canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
    #splash::before {
      content: "";
      position: absolute;
      inset: -20%;
      background: radial-gradient(ellipse at 50% 45%, rgba(38, 152, 186, 0.16), transparent 55%);
      pointer-events: none;
    }
    .splash-inner { position: relative; text-align: center; padding: 0 1.25rem; max-width: 48rem; }
    .splash-name {
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      column-gap: 0.3em;
      font-family: "Roboto Slab", Georgia, serif;
      font-weight: 700;
      font-size: clamp(1.9rem, 7.5vw, 4.6rem);
      line-height: 1.15;
      letter-spacing: 0.05em;
    }
    .splash-name .word { display: inline-flex; white-space: nowrap; }
    .splash-name .ch { display: inline-block; opacity: 0; transform: translateY(0.45em); filter: blur(10px); }
    .is-ready .splash-name .ch {
      animation: splash-ch 0.85s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
      animation-delay: calc(var(--i) * 55ms + 150ms);
    }
    @keyframes splash-ch { to { opacity: 1; transform: none; filter: blur(0); } }
    .splash-rule {
      width: min(16rem, 60vw);
      height: 1px;
      margin: 1.2rem auto 1rem;
      background: linear-gradient(90deg, transparent, var(--global-theme-color, #2698ba), transparent);
      transform: scaleX(0);
      opacity: 0;
    }
    .is-ready .splash-rule { animation: splash-rule 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 1.05s forwards; }
    @keyframes splash-rule { to { transform: scaleX(1); opacity: 1; } }
    .splash-sub {
      margin: 0;
      font-size: clamp(0.78rem, 1.6vw, 0.95rem);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--global-text-color-light, #828282);
      opacity: 0;
      transform: translateY(8px);
    }
    .is-ready .splash-sub { animation: splash-up 0.9s ease 1.35s forwards; }
    @keyframes splash-up { to { opacity: 1; transform: none; } }
    /* "Hello" in many languages, scattered by splash.liquid and drifting slowly */
    .splash-float { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
    .splash-float .fw {
      position: absolute;
      white-space: nowrap;
      font-size: calc(var(--fs, 1.4) * 1rem);
      font-weight: 300;
      letter-spacing: 0.04em;
      color: var(--global-text-color, #000);
      opacity: 0;
      transform: translate(-50%, -50%);
      will-change: transform, opacity;
      animation:
        splash-fw-in 1.4s ease var(--in-delay, 0.5s) forwards,
        splash-fw-drift var(--dur, 26s) ease-in-out var(--in-delay, 0.5s) infinite alternate;
    }
    @media (max-width: 575px) { .splash-float .fw { font-size: calc(var(--fs, 1.4) * 0.72rem); } }
    @keyframes splash-fw-in { to { opacity: var(--op, 0.35); } }
    @keyframes splash-fw-drift {
      from { transform: translate(-50%, -50%); }
      to { transform: translate(calc(-50% + var(--dx, 20px)), calc(-50% + var(--dy, -20px))); }
    }
    /* Down arrow at the bottom: click / scroll / swipe to enter */
    .splash-down {
      position: absolute;
      left: 50%;
      bottom: calc(1.4rem + env(safe-area-inset-bottom, 0px));
      width: 3rem;
      height: 3rem;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--global-text-color-light, #828282);
      cursor: pointer;
      opacity: 0;
      transform: translate(-50%, 0);
      transition: color 0.3s ease;
      -webkit-tap-highlight-color: transparent;
    }
    .is-ready .splash-down {
      animation:
        splash-down-in 0.9s ease 1.6s forwards,
        splash-bounce 2.2s ease-in-out 2.5s infinite;
    }
    .splash-down:hover, .splash-down:focus-visible { color: var(--global-theme-color, #2698ba); outline: none; }
    @keyframes splash-down-in { to { opacity: 0.85; } }
    @keyframes splash-bounce {
      0%, 100% { transform: translate(-50%, 0); }
      50% { transform: translate(-50%, 9px); }
    }
  </style>
{% endif %}

<!-- English / 中文 toggle. The saved preference is applied before first paint (like the theme), so nothing flickers.
     Content carries .lang-en / .lang-zh spans (see _includes/lang.liquid); the button lives in _includes/header.liquid. -->
<script>
  (function () {
    var root = document.documentElement;
    function applyLang(lang) {
      root.setAttribute("data-lang", lang);
      root.setAttribute("lang", lang === "zh" ? "zh-CN" : "{{ site.lang | default: 'en' }}");
    }
    var saved = null;
    try {
      saved = localStorage.getItem("lang");
    } catch (e) {}
    applyLang(saved === "zh" ? "zh" : "en");
    window.toggleLang = function () {
      var next = root.getAttribute("data-lang") === "zh" ? "en" : "zh";
      try {
        localStorage.setItem("lang", next);
      } catch (e) {}
      applyLang(next);
    };
    document.addEventListener("DOMContentLoaded", function () {
      var btn = document.getElementById("lang-toggle");
      if (btn) btn.addEventListener("click", window.toggleLang);
    });
  })();
</script>
<style>
  html[data-lang="zh"] .lang-en, html:not([data-lang="zh"]) .lang-zh { display: none !important; }
  /* Latin text keeps the site font; CJK glyphs fall through to a decent system font instead of SimSun */
  html[data-lang="zh"] body { font-family: "Roboto", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", "Noto Sans SC", sans-serif; }
  #lang-toggle {
    padding: 0 0.15rem;
    border: 0;
    background-color: inherit;
    color: var(--global-text-color);
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    height: 2rem;
    min-width: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  #lang-toggle:hover { color: var(--global-hover-color); }
  @media (min-width: 576px) { #lang-toggle { transform: translateY(4px); margin-left: 0.25rem; } }
</style>

<!-- ===== Navbar: glass bar that gains a shadow once the page scrolls, a pill that slides to the hovered link
     and rests on the current page, round theme / chip language toggles, gradient scroll bar.
     Markup: _includes/header.liquid (the theme toggle <li> carries .nav-tools-start). -->
<style>
  #navbar {
    --nav-pill: rgba(38, 152, 186, 0.13);
    --nav-pill: color-mix(in srgb, var(--global-theme-color) 13%, transparent);
    opacity: 1;
    min-height: 56px;
    border-bottom: 1px solid transparent;
    transition: background-color 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
  }
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    #navbar {
      background-color: color-mix(in srgb, var(--global-bg-color) 76%, transparent);
      -webkit-backdrop-filter: saturate(180%) blur(16px);
      backdrop-filter: saturate(180%) blur(16px);
    }
  }
  #navbar.is-scrolled { border-bottom-color: var(--global-divider-color); box-shadow: 0 8px 28px rgba(0, 0, 0, 0.07); }
  html[data-theme="dark"] #navbar.is-scrolled { box-shadow: 0 8px 28px rgba(0, 0, 0, 0.4); }

  /* Name with an accent full stop (on the name span: the <a> also holds whitespace) */
  #navbar .navbar-brand { letter-spacing: -0.01em; transition: color 0.25s ease; }
  #navbar .navbar-brand > span::after {
    content: "";
    display: inline-block;
    width: 0.38rem;
    height: 0.38rem;
    margin-left: 0.18rem;
    border-radius: 50%;
    background: var(--global-theme-color);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  #navbar .navbar-brand:hover { color: var(--global-theme-color); }
  #navbar .navbar-brand:hover > span::after { transform: scale(1.5); }

  #navbar.navbar-light .navbar-nav .nav-item .nav-link { border-radius: 999px; transition: color 0.25s ease, background-color 0.25s ease; }
  #navbar.navbar-light .navbar-nav .nav-item.active > .nav-link { font-weight: 500; background-color: var(--nav-pill); }
  @media (max-width: 575.98px) {
    #navbar.navbar-light .navbar-nav .nav-item .nav-link { display: inline-block; padding: 0.45rem 0.8rem; }
    /* Open menu: one link per row, the two toggles side by side on the last row */
    #navbar .navbar-nav { flex-direction: row; flex-wrap: wrap; align-items: center; padding-bottom: 0.5rem; }
    #navbar .navbar-nav > .nav-item { width: 100%; }
    #navbar .nav-indicator { display: none; }
    #navbar .nav-tools-start { margin-top: 0.4rem; }
    #navbar #lang-toggle { margin-left: 0.5rem; }
  }

  @media (min-width: 576px) {
    #navbar .navbar-nav { position: relative; align-items: center; gap: 0.1rem; }
    #navbar.navbar-light .navbar-nav .nav-item .nav-link {
      position: relative;
      z-index: 1;
      padding: 0.36rem 0.8rem;
      font-size: 0.95rem;
      letter-spacing: 0.01em;
    }
    /* With the script running, the moving pill replaces the static one */
    #navbar.navbar-light .navbar-nav.has-indicator .nav-item.active > .nav-link { background-color: transparent; }
    /* Liquid pill: left and right edges move separately (the script delays the trailing one), with an accent rim */
    #navbar .nav-indicator {
      --dl: 0s;
      --dr: 0s;
      position: absolute;
      left: 0;
      right: 100%;
      top: 0;
      z-index: 0;
      height: 0;
      list-style: none;
      border-radius: 999px;
      background: var(--nav-pill);
      background: linear-gradient(180deg, color-mix(in srgb, var(--global-theme-color) 18%, transparent), color-mix(in srgb, var(--global-theme-color) 8%, transparent));
      box-shadow:
        inset 0 0 0 1px color-mix(in srgb, var(--global-theme-color) 30%, transparent),
        0 6px 18px -8px color-mix(in srgb, var(--global-theme-color) 75%, transparent);
      opacity: 0;
      pointer-events: none;
      transition:
        left 0.42s cubic-bezier(0.3, 0.9, 0.3, 1) var(--dl),
        right 0.42s cubic-bezier(0.3, 0.9, 0.3, 1) var(--dr),
        top 0.3s ease,
        height 0.3s ease,
        opacity 0.25s ease;
    }
    #navbar .nav-indicator.no-anim { transition: none; }
    #navbar .nav-tools-start { margin-left: 0.6rem; padding-left: 0.7rem; border-left: 1px solid var(--global-divider-color); }
    #navbar .toggle-container { display: flex; align-items: center; }
  }

  #light-toggle, #lang-toggle { transform: none !important; border-radius: 999px; transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease; }
  #light-toggle { width: 2.1rem; height: 2.1rem; }
  #light-toggle i { transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1); }
  #light-toggle:hover { background-color: var(--nav-pill); }
  #light-toggle:hover i { transform: rotate(-30deg); }
  #lang-toggle {
    height: 1.9rem;
    padding: 0 0.7rem;
    margin-left: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    border: 1px solid var(--global-divider-color);
  }
  #lang-toggle:hover { background-color: var(--nav-pill); border-color: var(--global-theme-color); }


  /* Cursor light (mouse only): a soft glow follows the cursor along the bar and lights the hairline under it */
  @media (hover: hover) and (pointer: fine) {
    #navbar { --nx: 50%; }
    #navbar::before,
    #navbar::after { content: ""; position: absolute; pointer-events: none; opacity: 0; transition: opacity 0.45s ease; }
    #navbar::before {
      inset: 0;
      z-index: -1;
      background: radial-gradient(340px circle at var(--nx) 50%, color-mix(in srgb, var(--global-theme-color) 11%, transparent), transparent 70%);
    }
    #navbar::after {
      left: 0;
      right: 0;
      bottom: -1px;
      height: 3px;
      background: radial-gradient(ellipse 200px 3px at var(--nx) 50%, var(--global-theme-color), transparent);
    }
    #navbar.is-lit::before,
    #navbar.is-lit::after { opacity: 1; }
  }

  /* The accent dot breathes: a faint ring every few seconds */
  #navbar .navbar-brand > span::after { animation: nav-dot 3.4s ease-out infinite; }
  @keyframes nav-dot {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--global-theme-color) 55%, transparent); }
    70%, 100% { box-shadow: 0 0 0 6px color-mix(in srgb, var(--global-theme-color) 0%, transparent); }
  }

  @media (prefers-reduced-motion: reduce) {
    #navbar, #navbar *, #navbar .nav-indicator { transition: none !important; }
    #navbar::before, #navbar::after { display: none; }
    #navbar .navbar-brand > span::after { animation: none; }
  }
</style>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    var nav = document.getElementById("navbar");
    if (!nav) return;
    var onScroll = function () {
      nav.classList.toggle("is-scrolled", window.scrollY > 4);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    var fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    var still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (fine && !still) {
      var raf = 0;
      var nx = 0;
      nav.addEventListener("mousemove", function (e) {
        nx = (e.clientX - nav.getBoundingClientRect().left) / (window.pageZoom ? window.pageZoom() : 1);
        if (!raf)
          raf = requestAnimationFrame(function () {
            raf = 0;
            nav.style.setProperty("--nx", nx + "px");
          });
      });
      nav.addEventListener("mouseenter", function () {
        nav.classList.add("is-lit");
      });
      nav.addEventListener("mouseleave", function () {
        nav.classList.remove("is-lit");
      });
    }

    var list = nav.querySelector(".navbar-nav");
    if (!list) return;
    var wide = window.matchMedia("(min-width: 576px)");
    var pill = document.createElement("li");
    pill.className = "nav-indicator no-anim";
    pill.setAttribute("aria-hidden", "true");
    list.insertBefore(pill, list.firstChild);
    list.classList.add("has-indicator");

    function place(link) {
      if (!link || !wide.matches) {
        pill.style.opacity = "0";
        return;
      }
      var z = window.pageZoom ? window.pageZoom() : 1;
      var a = link.getBoundingClientRect();
      var b = list.getBoundingClientRect();
      var left = (a.left - b.left) / z;
      var prev = parseFloat(pill.style.left);
      var goingRight = !isNaN(prev) && left > prev;
      // Liquid stretch: the leading edge sets off first, the trailing edge catches up
      pill.style.setProperty("--dl", goingRight ? "0.08s" : "0s");
      pill.style.setProperty("--dr", goingRight ? "0s" : "0.08s");
      pill.style.left = left + "px";
      pill.style.right = (b.width - a.width) / z - left + "px";
      pill.style.top = (a.top - b.top) / z + "px";
      pill.style.height = a.height / z + "px";
      pill.style.opacity = "1";
    }
    function rest() {
      place(list.querySelector(".nav-item.active > .nav-link"));
    }
    function settle() {
      pill.classList.add("no-anim");
      rest();
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          pill.classList.remove("no-anim");
        });
      });
    }
    list.querySelectorAll(".nav-item > .nav-link").forEach(function (link) {
      link.addEventListener("mouseenter", function () {
        place(link);
      });
      link.addEventListener("focus", function () {
        place(link);
      });
    });
    list.addEventListener("mouseleave", rest);
    list.addEventListener("focusout", function (e) {
      if (!list.contains(e.relatedTarget)) rest();
    });
    window.addEventListener("resize", settle);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(settle);
    var lang = document.getElementById("lang-toggle");
    if (lang) lang.addEventListener("click", function () {
      requestAnimationFrame(settle);
    });
    settle();
  });
</script>

<!-- ===== Homepage contact icons: brand colours at rest; on hover they pop up with a small wobble and a glow in
     their own colour; a click presses them in and sends out a ring. Markup comes from the gem ({% raw %}{% social_links %}{% endraw %}). -->
<style>
  .social .contact-icons a { --c: var(--global-theme-color); position: relative; display: inline-block; margin: 0 0.35rem; }
  .social .contact-icons a[href*="github.com"] { --c: #8250df; } /* GitHub Primer purple (user: black looked plain) */
  html[data-theme="dark"] .social .contact-icons a[href*="github.com"] { --c: #a371f7; }
  .social .contact-icons a[href*="scholar.google"] { --c: #4285f4; }
  .social .contact-icons a[href*="linkedin.com"] { --c: #0a66c2; }
  .social .contact-icons a i { display: inline-block; transition: transform 0.45s cubic-bezier(0.3, 1.6, 0.5, 1), filter 0.35s ease; }
  .social .contact-icons a i::before,
  .social .contact-icons a:hover i::before { color: var(--c); }
  .social .contact-icons a:hover i,
  .social .contact-icons a:focus-visible i {
    animation: icon-pop 0.6s cubic-bezier(0.3, 1.4, 0.5, 1) both;
    filter: drop-shadow(0 10px 14px color-mix(in srgb, var(--c) 45%, transparent));
  }
  .social .contact-icons a:active i { transform: translateY(-2px) scale(0.9); animation: none; transition-duration: 0.12s; }
  @keyframes icon-pop {
    0% { transform: translateY(0) scale(1) rotate(0); }
    40% { transform: translateY(-9px) scale(1.18) rotate(-8deg); }
    70% { transform: translateY(-5px) scale(1.1) rotate(5deg); }
    100% { transform: translateY(-6px) scale(1.12) rotate(0); }
  }
  /* Click ring */
  .social .contact-icons a::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 3.2rem;
    height: 3.2rem;
    margin: -1.6rem 0 0 -1.6rem;
    border-radius: 50%;
    border: 2px solid var(--c);
    opacity: 0;
    pointer-events: none;
  }
  .social .contact-icons a.is-ring::after { animation: icon-ring 0.6s ease-out; }
  @keyframes icon-ring {
    0% { transform: scale(0.6); opacity: 0.8; }
    100% { transform: scale(1.8); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .social .contact-icons a i, .social .contact-icons a::after { animation: none !important; transition: none !important; }
  }
</style>
<script>
  document.addEventListener("pointerdown", function (e) {
    var a = e.target.closest && e.target.closest(".social .contact-icons a");
    if (!a) return;
    a.classList.remove("is-ring");
    void a.offsetWidth; // restart the animation on repeated clicks
    a.classList.add("is-ring");
    a.addEventListener("animationend", function done() {
      a.classList.remove("is-ring");
      a.removeEventListener("animationend", done);
    });
  });
</script>

<!-- ===== Side scroll progress (replaces the top progress bar, enable_progressbar: false): a slim rail on the right,
     vertically centred; a gradient fill and a glowing knob follow the scroll, with the percentage beside the knob.
     Full strength while scrolling, faint when idle, hidden when the page cannot scroll and on screens below 768px. -->
<style>
  #side-progress {
    --p: 0%;
    position: fixed;
    right: 20px;
    top: 50%;
    z-index: 1020;
    width: 3px;
    height: 150px;
    margin-top: -75px;
    border-radius: 3px;
    background: var(--global-divider-color);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s ease;
  }
  #side-progress.is-scrollable { opacity: 0.4; }
  #side-progress.is-scrollable.is-active { opacity: 1; }
  #side-progress .sp-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: var(--p);
    border-radius: inherit;
    background: linear-gradient(180deg, color-mix(in srgb, var(--global-theme-color) 35%, transparent), var(--global-theme-color));
  }
  #side-progress .sp-knob {
    position: absolute;
    left: 50%;
    top: var(--p);
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    background: var(--global-theme-color);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--global-theme-color) 18%, transparent), 0 0 12px color-mix(in srgb, var(--global-theme-color) 60%, transparent);
  }
  #side-progress .sp-pct {
    position: absolute;
    right: 14px;
    top: var(--p);
    transform: translate(4px, -50%);
    font: 600 11px/1 "Cascadia Mono", Consolas, ui-monospace, monospace;
    letter-spacing: 0.04em;
    color: var(--global-theme-color);
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  #side-progress.is-active .sp-pct { opacity: 1; transform: translate(0, -50%); }
  @media (max-width: 767.98px) { #side-progress { display: none; } }
  @media (prefers-reduced-motion: reduce) { #side-progress, #side-progress * { transition: none !important; } }
</style>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    var rail = document.createElement("div");
    rail.id = "side-progress";
    rail.setAttribute("aria-hidden", "true");
    rail.innerHTML = '<div class="sp-fill"></div><div class="sp-knob"></div><div class="sp-pct">0%</div>';
    document.body.appendChild(rail);
    var pct = rail.querySelector(".sp-pct");
    var idle = 0;
    var raf = 0;
    function update() {
      raf = 0;
      var root = document.documentElement;
      var max = root.scrollHeight - root.clientHeight;
      rail.classList.toggle("is-scrollable", max > 40);
      var p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      rail.style.setProperty("--p", (p * 100).toFixed(2) + "%");
      pct.textContent = Math.round(p * 100) + "%";
    }
    window.addEventListener(
      "scroll",
      function () {
        if (!raf) raf = requestAnimationFrame(update);
        rail.classList.add("is-active");
        clearTimeout(idle);
        idle = setTimeout(function () {
          rail.classList.remove("is-active");
        }, 1200);
      },
      { passive: true }
    );
    window.addEventListener("resize", update);
    window.addEventListener("load", update);
    update();
  });
</script>

