<!-- Custom override: use a blue accent in light mode too (dark mode keeps its own, higher-specificity color) -->
<style>
  :root {
    --global-theme-color: #2698ba;
    --global-hover-color: #2698ba;
    --global-code-bg-color: rgba(38, 152, 186, 0.05);
  }
  /* ===== Projects: equal-height cards, icon row pinned to the bottom, cursor-following tilt + spotlight ===== */
  .projects .col { perspective: 1000px; }
  .projects .card {
    --rx: 0deg; --ry: 0deg; --mx: 50%; --my: 50%;
    position: relative;
    overflow: hidden;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform .5s cubic-bezier(.2, .7, .2, 1), box-shadow .5s ease;
  }
  .projects .card.is-tilting { transition: transform .1s linear, box-shadow .5s ease; }
  .projects .card:hover {
    transform: rotateX(var(--rx)) rotateY(var(--ry)) translateY(-8px);
    box-shadow: 0 22px 40px rgba(0, 0, 0, .16), 0 6px 14px rgba(0, 0, 0, .08);
  }
  /* The title link is "stretched" over the whole card (no nested anchors, see projects.liquid) */
  .projects .card-title .project-link { color: inherit; text-decoration: none; }
  .projects .card-title .project-link::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .projects .card-body .project-links { position: relative; z-index: 4; }
  /* spotlight that follows the cursor */
  .projects .card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(360px circle at var(--mx) var(--my), rgba(38, 152, 186, .16), transparent 60%);
    transition: opacity .35s ease;
  }
  /* glowing accent border that brightens near the cursor */
  .projects .card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    padding: 1.5px;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(320px circle at var(--mx) var(--my), var(--global-theme-color), rgba(38, 152, 186, .15) 70%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    transition: opacity .35s ease;
  }
  @supports (color: color-mix(in srgb, red, red)) {
    .projects .card::after { background: radial-gradient(360px circle at var(--mx) var(--my), color-mix(in srgb, var(--global-theme-color) 16%, transparent), transparent 60%); }
    .projects .card::before { background: radial-gradient(320px circle at var(--mx) var(--my), var(--global-theme-color), color-mix(in srgb, var(--global-theme-color) 15%, transparent) 70%); }
  }
  .projects .card:hover::after, .projects .card:hover::before { opacity: 1; }
  .projects .card figure { margin: 0; overflow: hidden; }
  .projects .card-img-top { aspect-ratio: 2 / 1; object-fit: cover; width: 100%; transition: transform .7s cubic-bezier(.2, .7, .2, 1); }
  .projects .card:hover .card-img-top { transform: scale(1.06); }
  .projects .card-title { transition: color .25s ease; }
  .projects .card:hover .card-title { color: var(--global-theme-color); }
  .projects .card-body { display: flex; flex-direction: column; }
  .projects .card-body .card-text { flex: 1 1 auto; }
  .projects .card-body > .row { margin-top: auto; padding-top: .9rem; }
  .projects .card-body .github-icon { margin-right: 1.1rem; }
  .projects .card-body .github-icon:last-child { margin-right: 0; }
  .projects .card-body .gh-icon { display: inline-block; transition: transform .2s ease, color .2s ease; }
  .projects .card-body .icon a:hover .gh-icon { transform: translateY(-2px) scale(1.2); color: var(--global-theme-color); }

  /* ===== Publications: per-entry hover highlight (tint + accent bar + cursor glow), lively thumbnails and buttons ===== */
  .publications ol.bibliography > li > .row {
    --mx: 50%; --my: 50%;
    position: relative;
    border-radius: .6rem;
    padding: .6rem 0;
    transition: background-color .3s ease, transform .3s cubic-bezier(.2, .7, .2, 1), box-shadow .3s ease;
  }
  .publications ol.bibliography > li > .row::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1rem;
    bottom: 1rem;
    width: 3px;
    border-radius: 3px;
    background: var(--global-theme-color);
    transform: scaleY(0);
    transition: transform .3s ease;
  }
  .publications ol.bibliography > li > .row::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(420px circle at var(--mx) var(--my), rgba(38, 152, 186, .12), transparent 60%);
    transition: opacity .35s ease;
  }
  .publications ol.bibliography > li > .row:hover {
    background: rgba(38, 152, 186, .05);
    transform: translateX(6px);
    box-shadow: 0 10px 26px rgba(0, 0, 0, .07);
  }
  @supports (color: color-mix(in srgb, red, red)) {
    .publications ol.bibliography > li > .row:hover { background: color-mix(in srgb, var(--global-theme-color) 5%, transparent); }
    .publications ol.bibliography > li > .row::after { background: radial-gradient(420px circle at var(--mx) var(--my), color-mix(in srgb, var(--global-theme-color) 12%, transparent), transparent 60%); }
  }
  .publications ol.bibliography > li > .row:hover::before { transform: scaleY(1); }
  .publications ol.bibliography > li > .row:hover::after { opacity: 1; }
  .publications ol.bibliography > li > .row > * { position: relative; z-index: 1; }
  .publications .preview { transition: transform .4s cubic-bezier(.2, .7, .2, 1), box-shadow .4s ease; }
  .publications ol.bibliography > li > .row:hover .preview { transform: translateY(-3px) scale(1.04); box-shadow: 0 10px 22px rgba(0, 0, 0, .18); }
  .publications .title a { transition: color .2s ease; }
  .publications .links .btn {
    border-color: var(--global-divider-color, #ddd);
    transition: background-color .2s ease, color .2s ease, border-color .2s ease, transform .2s ease, box-shadow .2s ease;
  }
  .publications .links .btn:hover {
    background: var(--global-theme-color);
    border-color: var(--global-theme-color);
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(38, 152, 186, .35);
  }

  /* ===== Gentle staggered entrance for project cards and publication entries ===== */
  @keyframes rise-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  .projects .col, .publications ol.bibliography > li { animation: rise-in .55s cubic-bezier(.2, .7, .2, 1) both; }
  .projects .col:nth-child(2), .publications ol.bibliography > li:nth-child(2) { animation-delay: .07s; }
  .projects .col:nth-child(3), .publications ol.bibliography > li:nth-child(3) { animation-delay: .14s; }
  .projects .col:nth-child(4), .publications ol.bibliography > li:nth-child(4) { animation-delay: .21s; }
  .projects .col:nth-child(5), .publications ol.bibliography > li:nth-child(5) { animation-delay: .28s; }
  .projects .col:nth-child(n + 6), .publications ol.bibliography > li:nth-child(n + 6) { animation-delay: .35s; }
  @media (prefers-reduced-motion: reduce) {
    .projects .col, .publications ol.bibliography > li { animation: none; }
    .projects .card, .projects .card-img-top, .projects .gh-icon, .publications ol.bibliography > li > .row,
    .publications .preview, .publications .links .btn { transition: none; }
    .projects .card, .projects .card:hover, .projects .card:hover .card-img-top, .publications ol.bibliography > li > .row:hover { transform: none; }
  }
  /* Slightly smaller profile avatar on tablet/desktop */
  @media (min-width: 576px) { .profile { width: 27%; } }
  /* Pronouns after the hero name only (scoped to the bold-name heading) */
  .post-title:has(> span.font-weight-bold)::after {
    content: " (he/him)";
    font-size: 0.5em;
    font-weight: 400;
    color: var(--global-text-color-light);
    white-space: nowrap;
  }
  /* Keep the publications list author-free; full authors stay in the BibTeX (BibTeX button) */
  .publications .author { display: none; }
  /* Paper titles are links (see _layouts/bib.liquid): keep the text colour, show the accent on hover */
  .publications .title a { color: inherit; text-decoration: none; }
  .publications .title a:hover { color: var(--global-theme-color); text-decoration: underline; text-underline-offset: 0.15em; }
  /* Underline beneath the hero slogan/subtitle */
  .desc { display: inline-block; border-bottom: 1px solid var(--global-divider-color, #e8e8e8); padding-bottom: 0.4rem; }
  /* English rendering of the slogan, in a script face (font loaded via third_party_libraries.google_fonts) */
  .desc .subtitle-en {
    display: inline-block;
    margin-top: 0.2rem;
    font-family: "Great Vibes", cursive;
    font-size: 1.3em;
    line-height: 1.3;
    color: var(--global-text-color-light);
  }
</style>
<script>
  // Cursor-following tilt (project cards) and spotlight (project cards + publication entries).
  // Hover-capable, fine-pointer devices only; disabled when the user prefers reduced motion.
  (function () {
    function init() {
      if (!window.matchMedia || !window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      function bind(el, tilt) {
        var rect = null, raf = null, last = null;
        function apply() {
          raf = null;
          if (!rect || !last) return;
          var x = last.clientX - rect.left, y = last.clientY - rect.top;
          el.style.setProperty("--mx", x.toFixed(1) + "px");
          el.style.setProperty("--my", y.toFixed(1) + "px");
          if (tilt) {
            el.style.setProperty("--rx", ((0.5 - y / rect.height) * 7).toFixed(2) + "deg");
            el.style.setProperty("--ry", ((x / rect.width - 0.5) * 9).toFixed(2) + "deg");
          }
        }
        el.addEventListener("mouseenter", function (e) {
          rect = el.getBoundingClientRect();
          last = e;
          if (tilt) el.classList.add("is-tilting");
          apply();
        });
        el.addEventListener("mousemove", function (e) {
          last = e;
          if (!raf) raf = requestAnimationFrame(apply);
        });
        el.addEventListener("mouseleave", function () {
          rect = null;
          last = null;
          if (tilt) {
            el.classList.remove("is-tilting");
            el.style.setProperty("--rx", "0deg");
            el.style.setProperty("--ry", "0deg");
          }
        });
      }
      document.querySelectorAll(".projects .card").forEach(function (el) { bind(el, true); });
      document.querySelectorAll(".publications ol.bibliography > li > .row").forEach(function (el) { bind(el, false); });
    }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
    else init();
  })();
</script>

{% if page.splash.enabled %}
  <!-- Intro splash (homepage). Decided before first paint so nothing flickers; markup + behaviour live in
       _includes/splash.liquid, rendered by the local _layouts/about.liquid. -->
  <script>
    (function () {
      var root = document.documentElement;
      try {
        var force = /[?&#]splash\b/.test(location.search + location.hash);
        if (!force) {
          if (sessionStorage.getItem("jd-splash-seen") === "1") return;
          if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        }
      } catch (e) {}
      root.classList.add("splash-pending");
      // Backstop: never leave the page hidden if the splash script fails to run
      // (it sets window.__splashOk once it is up; from then on only its button dismisses it).
      setTimeout(function () {
        if (!window.__splashOk) root.classList.remove("splash-pending");
      }, 6000);
    })();
  </script>
  <style>
    html.splash-pending { overflow: hidden; }
    html.splash-pending body > * { visibility: hidden; }
    #splash {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 2147483000;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: var(--global-bg-color, #fff);
      color: var(--global-text-color, #000);
      overflow: hidden;
      user-select: none;
      -webkit-user-select: none;
      -webkit-tap-highlight-color: transparent;
      touch-action: none;
      transition: transform 0.95s cubic-bezier(0.76, 0, 0.24, 1);
    }
    html.splash-pending #splash, html.splash-leaving #splash { display: flex; visibility: visible; }
    #splash.is-out { transform: translateY(-100%); pointer-events: none; }
    html.splash-leaving { overflow: hidden; } /* keep the page at the top while the curtain lifts */
    #splash canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
    #splash::before {
      content: "";
      position: absolute;
      inset: -20%;
      background: radial-gradient(ellipse at 50% 45%, rgba(38, 152, 186, 0.16), transparent 55%);
      pointer-events: none;
    }
    .splash-inner { position: relative; text-align: center; padding: 0 1.25rem; max-width: 48rem; }
    .splash-name {
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      column-gap: 0.3em;
      font-family: "Roboto Slab", Georgia, serif;
      font-weight: 700;
      font-size: clamp(1.9rem, 7.5vw, 4.6rem);
      line-height: 1.15;
      letter-spacing: 0.05em;
    }
    .splash-name .word { display: inline-flex; white-space: nowrap; }
    .splash-name .ch { display: inline-block; opacity: 0; transform: translateY(0.45em); filter: blur(10px); }
    .is-ready .splash-name .ch {
      animation: splash-ch 0.85s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
      animation-delay: calc(var(--i) * 55ms + 150ms);
    }
    @keyframes splash-ch { to { opacity: 1; transform: none; filter: blur(0); } }
    .splash-rule {
      width: min(16rem, 60vw);
      height: 1px;
      margin: 1.2rem auto 1rem;
      background: linear-gradient(90deg, transparent, var(--global-theme-color, #2698ba), transparent);
      transform: scaleX(0);
      opacity: 0;
    }
    .is-ready .splash-rule { animation: splash-rule 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 1.05s forwards; }
    @keyframes splash-rule { to { transform: scaleX(1); opacity: 1; } }
    .splash-sub {
      margin: 0;
      font-size: clamp(0.78rem, 1.6vw, 0.95rem);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--global-text-color-light, #828282);
      opacity: 0;
      transform: translateY(8px);
    }
    .is-ready .splash-sub { animation: splash-up 0.9s ease 1.35s forwards; }
    @keyframes splash-up { to { opacity: 1; transform: none; } }
    /* "Hello" in many languages, scattered by splash.liquid and drifting slowly */
    .splash-float { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
    .splash-float .fw {
      position: absolute;
      white-space: nowrap;
      font-size: calc(var(--fs, 1.4) * 1rem);
      font-weight: 300;
      letter-spacing: 0.04em;
      color: var(--global-text-color, #000);
      opacity: 0;
      transform: translate(-50%, -50%);
      will-change: transform, opacity;
      animation:
        splash-fw-in 1.4s ease var(--in-delay, 0.5s) forwards,
        splash-fw-drift var(--dur, 26s) ease-in-out var(--in-delay, 0.5s) infinite alternate;
    }
    @media (max-width: 575px) { .splash-float .fw { font-size: calc(var(--fs, 1.4) * 0.72rem); } }
    @keyframes splash-fw-in { to { opacity: var(--op, 0.35); } }
    @keyframes splash-fw-drift {
      from { transform: translate(-50%, -50%); }
      to { transform: translate(calc(-50% + var(--dx, 20px)), calc(-50% + var(--dy, -20px))); }
    }
    /* Down arrow at the bottom: click / scroll / swipe to enter */
    .splash-down {
      position: absolute;
      left: 50%;
      bottom: calc(1.4rem + env(safe-area-inset-bottom, 0px));
      width: 3rem;
      height: 3rem;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--global-text-color-light, #828282);
      cursor: pointer;
      opacity: 0;
      transform: translate(-50%, 0);
      transition: color 0.3s ease;
      -webkit-tap-highlight-color: transparent;
    }
    .is-ready .splash-down {
      animation:
        splash-down-in 0.9s ease 1.6s forwards,
        splash-bounce 2.2s ease-in-out 2.5s infinite;
    }
    .splash-down:hover, .splash-down:focus-visible { color: var(--global-theme-color, #2698ba); outline: none; }
    @keyframes splash-down-in { to { opacity: 0.85; } }
    @keyframes splash-bounce {
      0%, 100% { transform: translate(-50%, 0); }
      50% { transform: translate(-50%, 9px); }
    }
  </style>
{% endif %}

<!-- English / 中文 toggle. The saved preference is applied before first paint (like the theme), so nothing flickers.
     Content carries .lang-en / .lang-zh spans (see _includes/lang.liquid); the button lives in _includes/header.liquid. -->
<script>
  (function () {
    var root = document.documentElement;
    function applyLang(lang) {
      root.setAttribute("data-lang", lang);
      root.setAttribute("lang", lang === "zh" ? "zh-CN" : "{{ site.lang | default: 'en' }}");
    }
    var saved = null;
    try {
      saved = localStorage.getItem("lang");
    } catch (e) {}
    applyLang(saved === "zh" ? "zh" : "en");
    window.toggleLang = function () {
      var next = root.getAttribute("data-lang") === "zh" ? "en" : "zh";
      try {
        localStorage.setItem("lang", next);
      } catch (e) {}
      applyLang(next);
    };
    document.addEventListener("DOMContentLoaded", function () {
      var btn = document.getElementById("lang-toggle");
      if (btn) btn.addEventListener("click", window.toggleLang);
    });
  })();
</script>
<style>
  html[data-lang="zh"] .lang-en, html:not([data-lang="zh"]) .lang-zh { display: none !important; }
  /* Latin text keeps the site font; CJK glyphs fall through to a decent system font instead of SimSun */
  html[data-lang="zh"] body { font-family: "Roboto", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", "Noto Sans SC", sans-serif; }
