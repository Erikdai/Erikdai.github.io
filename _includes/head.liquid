<!-- Metadata, OpenGraph and Schema.org -->
{% include metadata.liquid %}

<!-- Security: Content Security Policy -->
<!-- Permissive CSP suitable for academic websites. Allows external images, videos, and common embed services. -->
<!-- To customize for your needs, see: https://developer.mozilla.org/en-US/docs/Web/HTTP/CSP -->
<meta
  http-equiv="Content-Security-Policy"
  content="default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; media-src 'self' https:; frame-src 'self' https:; connect-src 'self' https:;"
>
<style>
  :root {
    --max-content-width: {{ site.max_width | default: '930px' }};
  }
</style>

<!-- Tailwind-first core styles -->
<link rel="stylesheet" href="{{ '/assets/css/tailwind.css' | relative_url | bust_file_cache }}">

{% if site.al_folio.compat.bootstrap.enabled %}
  <!-- Optional Bootstrap compatibility layer -->
  <link rel="stylesheet" href="{{ '/assets/css/bootstrap-compat.css' | relative_url | bust_file_cache }}">
{% endif %}

{% if page.pretty_table and site.al_folio.compat.bootstrap.enabled %}
  <!-- Bootstrap Table -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.bootstrap-table.url.css }}"
    integrity="{{ site.third_party_libraries.bootstrap-table.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if page.toc and page.toc.sidebar %}
  <!-- Tocbot -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.tocbot.url.css }}"
    integrity="{{ site.third_party_libraries.tocbot.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

<!-- Icons -->
{% if site.plugins contains 'al_icons' %}
  {% include plugins/al_icons_styles.liquid %}
{% endif %}
<link
  defer
  rel="stylesheet"
  type="text/css"
  href="{{ site.third_party_libraries.google_fonts.url.fonts }}"
>

<!-- Code Syntax Highlighting -->
<link
  defer
  rel="stylesheet"
  href="{{ '/assets/css/jekyll-pygments-themes-github.css' | relative_url | bust_file_cache }}"
  media=""
  id="highlight_theme_light"
>

<!-- Styles -->

{% if page.pseudocode %}
  <!-- pseudocode -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.pseudocode.url.css }}"
    integrity="{{ site.third_party_libraries.pseudocode.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if site.icon.size <= 4 %}
  <link
    rel="shortcut icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>"
  >
{% elsif site.icon != blank %}
  <link rel="shortcut icon" href="{{ site.icon | prepend: '/assets/img/' | relative_url | bust_file_cache}}">
{% endif %}
<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url | bust_css_cache }}">
{% if page.layout == 'cv' and site.plugins contains 'al_folio_cv' and site.al_folio.features.cv.enabled != false %}
  <link rel="stylesheet" href="{{ '/assets/css/al-folio-cv.css' | relative_url | bust_file_cache }}">
{% endif %}
<link rel="canonical" href="{{ page.url | replace:'index.html','' | absolute_url }}">

{% if site.enable_darkmode %}
  <!-- Dark Mode -->
  <script src="{{ '/assets/js/theme.js' | relative_url | bust_file_cache }}"></script>
  <link
    defer
    rel="stylesheet"
    href="{{ '/assets/css/jekyll-pygments-themes-native.css' | relative_url | bust_file_cache }}"
    media="none"
    id="highlight_theme_dark"
  >
  <script>
    initTheme();
  </script>
{% endif %}

{% if page.map %}
  <!-- GeoJSON support via Leaflet -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.leaflet.url.css }}"
    integrity="{{ site.third_party_libraries.leaflet.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if page.code_diff %}
  <!-- diff2html -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.highlightjs.url.css.light }}"
    integrity="{{ site.third_party_libraries.highlightjs.integrity.css.light }}"
    crossorigin="anonymous"
    media="screen and (prefers-color-scheme: light)"
  >
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.highlightjs.url.css.dark }}"
    integrity="{{ site.third_party_libraries.highlightjs.integrity.css.dark }}"
    crossorigin="anonymous"
    media="screen and (prefers-color-scheme: dark)"
  >
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.diff2html.url.css }}"
    integrity="{{ site.third_party_libraries.diff2html.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if site.plugins contains 'al_img_tools' %}
  <!-- Image Features -->
  {% include plugins/al_img_tools_styles.liquid %}
{% endif %}

{% if site.plugins contains 'al_math' %}
  {% include plugins/al_math_styles.liquid %}
{% endif %}

{% if site.enable_cookie_consent and site.plugins contains 'al_cookie' %}
  <!-- Cookie Consent -->
  {% include plugins/al_cookie_styles.liquid %}
{% endif %}

<!-- Custom override: use a blue accent in light mode too (dark mode keeps its own, higher-specificity color) -->
<style>
  :root {
    --global-theme-color: #2698ba;
    --global-hover-color: #2698ba;
    --global-code-bg-color: rgba(38, 152, 186, 0.05);
  }
  /* Uniform project card images */
  .projects .card-img-top { aspect-ratio: 2 / 1; object-fit: cover; width: 100%; }
  /* Slightly smaller profile avatar on tablet/desktop */
  @media (min-width: 576px) { .profile { width: 27%; } }
  /* Pronouns after the hero name only (scoped to the bold-name heading) */
  .post-title:has(> span.font-weight-bold)::after {
    content: " (he/him)";
    font-size: 0.5em;
    font-weight: 400;
    color: var(--global-text-color-light);
    white-space: nowrap;
  }
  /* Keep the publications list author-free; full authors stay in the BibTeX (BibTeX button) */
  .publications .author { display: none; }
  /* Paper titles are links (see _layouts/bib.liquid): keep the text colour, show the accent on hover */
  .publications .title a { color: inherit; text-decoration: none; }
  .publications .title a:hover { color: var(--global-theme-color); text-decoration: underline; text-underline-offset: 0.15em; }
  /* Underline beneath the hero slogan/subtitle */
  .desc { display: inline-block; border-bottom: 1px solid var(--global-divider-color, #e8e8e8); padding-bottom: 0.4rem; }
  /* English rendering of the slogan, in a script face (font loaded via third_party_libraries.google_fonts) */
  .desc .subtitle-en {
    display: inline-block;
    margin-top: 0.2rem;
    font-family: "Great Vibes", cursive;
    font-size: 1.3em;
    line-height: 1.3;
    color: var(--global-text-color-light);
  }
</style>

{% if page.splash.enabled %}
  <!-- Intro splash (homepage). Decided before first paint so nothing flickers; markup + behaviour live in
       _includes/splash.liquid, rendered by the local _layouts/about.liquid. -->
  <script>
    (function () {
      var root = document.documentElement;
      try {
        var force = /[?&#]splash\b/.test(location.search + location.hash);
        if (!force) {
          if (sessionStorage.getItem("jd-splash-seen") === "1") return;
          if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        }
      } catch (e) {}
      root.classList.add("splash-pending");
      // Backstop: never leave the page hidden if the splash script fails to run
      // (it sets window.__splashOk once it is up; from then on only its button dismisses it).
      setTimeout(function () {
        if (!window.__splashOk) root.classList.remove("splash-pending");
      }, 6000);
    })();
  </script>
  <style>
    html.splash-pending { overflow: hidden; }
    html.splash-pending body > * { visibility: hidden; }
    #splash {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 2147483000;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: var(--global-bg-color, #fff);
      color: var(--global-text-color, #000);
      overflow: hidden;
      user-select: none;
      -webkit-user-select: none;
      -webkit-tap-highlight-color: transparent;
      touch-action: none;
      transition: transform 0.95s cubic-bezier(0.76, 0, 0.24, 1);
    }
    html.splash-pending #splash, html.splash-leaving #splash { display: flex; visibility: visible; }
    #splash.is-out { transform: translateY(-100%); pointer-events: none; }
    html.splash-leaving { overflow: hidden; } /* keep the page at the top while the curtain lifts */
    #splash canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
    #splash::before {
      content: "";
      position: absolute;
      inset: -20%;
      background: radial-gradient(ellipse at 50% 45%, rgba(38, 152, 186, 0.16), transparent 55%);
      pointer-events: none;
    }
    .splash-inner { position: relative; text-align: center; padding: 0 1.25rem; max-width: 48rem; }
    .splash-name {
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      column-gap: 0.3em;
      font-family: "Roboto Slab", Georgia, serif;
      font-weight: 700;
      font-size: clamp(1.9rem, 7.5vw, 4.6rem);
      line-height: 1.15;
      letter-spacing: 0.05em;
    }
    .splash-name .word { display: inline-flex; white-space: nowrap; }
    .splash-name .ch { display: inline-block; opacity: 0; transform: translateY(0.45em); filter: blur(10px); }
    .is-ready .splash-name .ch {
      animation: splash-ch 0.85s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
      animation-delay: calc(var(--i) * 55ms + 150ms);
    }
    @keyframes splash-ch { to { opacity: 1; transform: none; filter: blur(0); } }
    .splash-rule {
      width: min(16rem, 60vw);
      height: 1px;
      margin: 1.2rem auto 1rem;
      background: linear-gradient(90deg, transparent, var(--global-theme-color, #2698ba), transparent);
      transform: scaleX(0);
      opacity: 0;
    }
    .is-ready .splash-rule { animation: splash-rule 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 1.05s forwards; }
    @keyframes splash-rule { to { transform: scaleX(1); opacity: 1; } }
    .splash-sub {
      margin: 0;
      font-size: clamp(0.78rem, 1.6vw, 0.95rem);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--global-text-color-light, #828282);
      opacity: 0;
      transform: translateY(8px);
    }
    .is-ready .splash-sub { animation: splash-up 0.9s ease 1.35s forwards; }
    @keyframes splash-up { to { opacity: 1; transform: none; } }
    /* "Hello" in many languages, scattered by splash.liquid and drifting slowly */
    .splash-float { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
    .splash-float .fw {
      position: absolute;
      white-space: nowrap;
      font-size: calc(var(--fs, 1.4) * 1rem);
      font-weight: 300;
      letter-spacing: 0.04em;
      color: var(--global-text-color, #000);
      opacity: 0;
      transform: translate(-50%, -50%);
      will-change: transform, opacity;
      animation:
        splash-fw-in 1.4s ease var(--in-delay, 0.5s) forwards,
        splash-fw-drift var(--dur, 26s) ease-in-out var(--in-delay, 0.5s) infinite alternate;
    }
    @media (max-width: 575px) { .splash-float .fw { font-size: calc(var(--fs, 1.4) * 0.72rem); } }
    @keyframes splash-fw-in { to { opacity: var(--op, 0.35); } }
    @keyframes splash-fw-drift {
      from { transform: translate(-50%, -50%); }
      to { transform: translate(calc(-50% + var(--dx, 20px)), calc(-50% + var(--dy, -20px))); }
    }
    /* Down arrow at the bottom: click / scroll / swipe to enter */
    .splash-down {
      position: absolute;
      left: 50%;
      bottom: calc(1.4rem + env(safe-area-inset-bottom, 0px));
      width: 3rem;
      height: 3rem;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--global-text-color-light, #828282);
      cursor: pointer;
      opacity: 0;
      transform: translate(-50%, 0);
      transition: color 0.3s ease;
      -webkit-tap-highlight-color: transparent;
    }
    .is-ready .splash-down {
      animation:
        splash-down-in 0.9s ease 1.6s forwards,
        splash-bounce 2.2s ease-in-out 2.5s infinite;
    }
    .splash-down:hover, .splash-down:focus-visible { color: var(--global-theme-color, #2698ba); outline: none; }
    @keyframes splash-down-in { to { opacity: 0.85; } }
    @keyframes splash-bounce {
      0%, 100% { transform: translate(-50%, 0); }
      50% { transform: translate(-50%, 9px); }
    }
  </style>
{% endif %}

<!-- English / 中文 toggle. The saved preference is applied before first paint (like the theme), so nothing flickers.
     Content carries .lang-en / .lang-zh spans (see _includes/lang.liquid); the button lives in _includes/header.liquid. -->
<script>
  (function () {
    var root = document.documentElement;
    function applyLang(lang) {
      root.setAttribute("data-lang", lang);
      root.setAttribute("lang", lang === "zh" ? "zh-CN" : "{{ site.lang | default: 'en' }}");
    }
    var saved = null;
    try {
      saved = localStorage.getItem("lang");
    } catch (e) {}
    applyLang(saved === "zh" ? "zh" : "en");
    window.toggleLang = function () {
      var next = root.getAttribute("data-lang") === "zh" ? "en" : "zh";
      try {
        localStorage.setItem("lang", next);
      } catch (e) {}
      applyLang(next);
    };
    document.addEventListener("DOMContentLoaded", function () {
      var btn = document.getElementById("lang-toggle");
      if (btn) btn.addEventListener("click", window.toggleLang);
    });
  })();
</script>
<style>
  html[data-lang="zh"] .lang-en, html:not([data-lang="zh"]) .lang-zh { display: none !important; }
  /* Latin text keeps the site font; CJK glyphs fall through to a decent system font instead of SimSun */
  html[data-lang="zh"] body { font-family: "Roboto", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", "Noto Sans SC", sans-serif; }
  #lang-toggle {
    padding: 0 0.15rem;
    border: 0;
    background-color: inherit;
    color: var(--global-text-color);
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    height: 2rem;
    min-width: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  #lang-toggle:hover { color: var(--global-hover-color); }
  @media (min-width: 576px) { #lang-toggle { transform: translateY(4px); margin-left: 0.25rem; } }
</style>
